# Temporales
*.log
node_modules/

# Archivo del trabajo anterior, recuperado del sitio viejo. No se publica:
# incluye fotos de una actividad con menores y logos de terceros.
Otras pegas/

# Fichas fuente de las apps. No se publican: algunas nombran direcciones
# internas de proyectos sin login, y rutas locales del disco. Al sitio solo
# entra lo que el generador vuelca en js/data.js, que va filtrado.
proyectos IA/

# Material original de los cursos: 4,2 GB de fotos y videos en bruto.
# Es el archivo de trabajo, no se publica. Al sitio solo entran las
# fotos ya seleccionadas y optimizadas de assets/img/cursos/.
Penta UC/

# Videos pesados: GitHub rechaza archivos sobre 100 MB.
# Súbelos a YouTube y enlázalos con { tipo: "youtube" } en data.js.
*.mp4
*.mov
*.MP4
*.MOV

# El CV con datos personales se queda en el disco. Lo que se publica es
# una copia sin RUT, direccion, fecha de nacimiento ni telefono, y vive
# en assets/files/.
/CV_*.pdf

# Briefs de trabajo y proyectos en cocina. No son contenido del sitio y
# alguno es material privado que Vicente no quiere publicado.
Prompt etapas/

# Cache de Python de las herramientas
__pycache__/
*.pyc
